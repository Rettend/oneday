{
  "name": "oneday",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "."
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vinxi dev --port 3100",
    "dev:agent": "vite dev --config vite.config.agent.ts",
    "build": "bun --bun vinxi build",
    "tauri": "tauri",
    "tauri:dev": "bun tauri dev",
    "tauri:build": "bun tauri build",
    "preview": "wrangler dev",
    "preview:agent": "wrangler dev --config wrangler.agent.toml",
    "deploy": "wrangler deploy",
    "deploy:agent": "wrangler deploy --config wrangler.agent.toml",
    "check": "tsgo --noEmit --skipLibCheck",
    "lint": "bun --bun eslint . --fix",
    "update": "taze latest -wr",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "bun test --conditions=browser",
    "test:watch": "bun test --watch --conditions=browser"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.54",
    "@ai-sdk/azure": "^3.0.40",
    "@ai-sdk/google": "^3.0.37",
    "@ai-sdk/groq": "^3.0.27",
    "@ai-sdk/openai": "^3.0.39",
    "@ai-sdk/xai": "^3.0.64",
    "@kobalte/core": "^0.13.11",
    "@libsql/client": "^0.17.0",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "@rttnd/agents": "^0.3.8",
    "@rttnd/ai-chat": "^0.0.5",
    "@rttnd/gau": "^1.4.2",
    "@rttnd/llm": "^1.5.0",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solid-primitives/storage": "^4.3.4",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "@solidjs/start": "^1.3.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-deep-link": "~2",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-opener": "~2",
    "ai": "^6.0.111",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.1",
    "solid-js": "^1.9.11",
    "tailwindcss-animate": "^1.0.7",
    "unocss-merge": "^0.8.2",
    "uuid": "^13.0.0",
    "vinxi": "^0.5.11",
    "workers-ai-provider": "^3.1.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.6.1",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^4.20260301.1",
    "@fontsource-variable/josefin-sans": "^5.2.8",
    "@happy-dom/global-registrator": "^20.8.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/utils": "^3.1.0",
    "@rttnd/unocss-preset-shadcn": "^1.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.3",
    "@typescript/native-preview": "^7.0.0-dev.20260304.1",
    "@unocss/eslint-plugin": "66.5.6",
    "@unocss/preset-icons": "66.5.6",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.0.2",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-solid": "^0.14.5",
