{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Oneday",
  "version": "0.1.0",
  "identifier": "me.rettend.oneday",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "oneday"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Oneday",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
